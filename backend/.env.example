SPRING_APPLICATION_NAME=travel-app
SPRING_PROFILES_ACTIVE=dev
PORT=8080

DATABASE_URL=jdbc:postgresql://db.cyjkygaevdcippenlfed.supabase.co:5432/postgres?ssl=true&sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_POOL_MAX_SIZE=10
DATABASE_CONNECTION_TIMEOUT_MS=30000
DATABASE_IDLE_TIMEOUT_MS=600000
DATABASE_MAX_LIFETIME_MS=1800000
DATABASE_POOL_NAME=SupabaseHikariPool

JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true
JPA_USE_SQL_COMMENTS=false
JPA_BATCH_SIZE=20

SUPABASE_URL=https://cyjkygaevdcippenlfed.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

UPLOAD_DIR=uploads/
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB

JWT_SECRET=
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=

MANAGEMENT_HEALTH_DETAILS=never
APP_LOG_LEVEL=DEBUG
SPRING_WEB_LOG_LEVEL=INFO
SPRING_TRANSACTION_LOG_LEVEL=INFO
HIBERNATE_SQL_LOG_LEVEL=INFO
HIBERNATE_BINDER_LOG_LEVEL=INFO
HIBERNATE_STAT_LOG_LEVEL=INFO
SERVER_ERROR_STACKTRACE=never
SERVER_ERROR_MESSAGE=never
